PORT=3000

# Bind to localhost by default. Do not use 0.0.0.0 unless you intentionally want LAN access.
HOST=127.0.0.1

# Optional secret embedded in the MCP endpoint path: /<token> and /mcp/<token>.
# Empty = no MCP authentication. Generate one with:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_TOKEN=

# Primary project root. Relative file paths, shell state, project memory, and Git default here.
WORKSPACE_PATH=C:\Users\YourName\projects\my-app

# Additional permitted project roots, separated by ; on Windows.
# EXTRA_WORKSPACE_PATHS=D:\Coding\other-repo

# slim = optimized ChatGPT-agent tool set with lower discovery/context overhead.
# full = every native Local Coder tool. Hidden slim helpers can also be enabled
# individually from Admin > MCP Servers > Local tools.
CHATGPT_TOOL_PROFILE=slim

# Terminal dashboard: auto (default), on, or off. Auto enables the clean TUI
# only in an interactive terminal and keeps plain logs for CI/redirected output.
LOCAL_CODER_TUI=auto
# Default timeout for synchronous run_command and run_commands_parallel calls.
# Individual calls can override this up to 3600 seconds; use start_process for continuous jobs.
SHELL_TIMEOUT=300
# Native Git tool timeout in milliseconds. Clamped to 5s..10m.
GIT_TIMEOUT_MS=300000
# Preferred desktop TUI height. Default 44 rows; bounded to 20..60.
# Use auto/0 to follow the current terminal height without requesting a resize.
LOCAL_CODER_TUI_HEIGHT=44

# Application-level permission policy config. Default when absent is open/full local access.
# See profiles/permissions.example.json.
# PERMISSIONS_CONFIG=profiles/permissions.json

# Native Local Coder hooks. See profiles/hooks.example.json.
# LOCAL_HOOKS_CONFIG=profiles/hooks.json
# LOCAL_HOOK_BUDGET_MS=30000

# External real-subagent runner. Disabled until explicitly configured.
# See profiles/subagents.example.json. This does NOT reuse the parent ChatGPT subscription.
# SUBAGENT_CONFIG=profiles/subagents.json
# SUBAGENT_ENABLED=false
# SUBAGENT_EXECUTABLE=
# SUBAGENT_ARGS_JSON=[]
# SUBAGENT_PROMPT_VIA_STDIN=true
# SUBAGENT_TIMEOUT_MS=1800000
# SUBAGENT_MAX_CONCURRENCY=4
# SUBAGENT_ISOLATION=none

# Legacy post-edit checks such as node --check or php -l.
# POST_EDIT_HOOKS_CONFIG=profiles/post-edit-hooks.json

# Persistent shell cwd/state across ChatGPT tool calls.
# MCP_SHELL_STATE_DIR=.mcp-state

# Durable coding-agent state for regular ChatGPT. These files hold task/plan
# progress and background-operation history, not model reasoning or a second AI.
# MCP_AGENT_TASK_STATE_DIR=.mcp-state/agent-tasks
# MCP_OPERATION_STATE_DIR=.mcp-state/operations
# MCP_EDIT_TRANSACTION_STATE_DIR=.mcp-state/edit-transactions
# MCP_EDIT_TRANSACTION_MAX_FILE_BYTES=16777216
# MCP_EDIT_TRANSACTION_MAX_TOTAL_BYTES=67108864
# MCP_CODING_LOOP_STATE_DIR=.mcp-state/coding-loops
# Compact resumable working context for regular ChatGPT. Machine state is auto-snapshotted;
# semantic summaries are saved by context_capsule because Local Coder cannot read hidden chat history.
# MCP_CONTEXT_CAPSULE_STATE_DIR=.mcp-state/context-capsules
# MCP_CONTEXT_CAPSULE_TOOL_CALLS=12
# MCP_CONTEXT_CAPSULE_RESULT_BYTES=65536
# MCP_CONTEXT_CAPSULE_ROLLOVER_CYCLES=3
# Optional root for coding_loop isolation=worktree. Leave blank to use the OS temp directory.
# Restricted permission profiles should point this inside an allowed root.
# MCP_CODING_LOOP_WORKTREE_ROOT=

# Phase 5 efficiency/recovery state. These are ephemeral/reconstructable and
# are pruned at startup after MCP_EPHEMERAL_STATE_RETENTION_DAYS.
# MCP_RESULT_STATE_DIR=.mcp-state/results
# MCP_PARALLEL_BATCH_STATE_DIR=.mcp-state/parallel-batches
# MCP_IDEMPOTENCY_STATE_DIR=.mcp-state/idempotency
# MCP_PROJECT_REGISTRY_PATH=.mcp-state/projects.json
# MCP_VERIFICATION_CACHE_STATE_DIR=.mcp-state/verification-cache
# MCP_VERIFICATION_CACHE_TTL_SECONDS=300
# In-memory text caching is heap-bounded. Files larger than the per-entry budget are read but not retained.
# MCP_TEXT_CACHE_MAX_BYTES=33554432
# MCP_TEXT_CACHE_MAX_ENTRY_BYTES=2097152
# MCP_TEXT_CACHE_MAX_ENTRIES=128
# Runtime identity is workspace-scoped automatically under .mcp-state/runtime-identities/.
# Set this only when you intentionally want an explicit identity-file location.
# MCP_RUNTIME_IDENTITY_PATH=
# MCP_EPHEMERAL_STATE_RETENTION_DAYS=30
# Doctor reports, but never auto-deletes, resumable task/loop/transaction state
# older than this threshold.
# MCP_STALE_STATE_HOURS=24

# Project-memory limits for CLAUDE.md / AGENTS.md injection.
# PROJECT_MEMORY_MAX_BYTES=25000
# PROJECT_MEMORY_MAX_LINES=200

# User memory is loaded automatically when present from supported local agent locations.
# Examples: %USERPROFILE%\.codex\CLAUDE.md or %USERPROFILE%\.claude\CLAUDE.md

# MCP tool annotations that reduce unnecessary ChatGPT confirmation prompts.
CHATGPT_AUTO_APPROVE=true

AUDIT_LOG_PATH=.mcp-audit.log

# Checkpoint / rewind.
CHECKPOINT_ENABLED=true
CHECKPOINT_PATH=.mcp-checkpoints
CHECKPOINT_MAX_COUNT=500
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_MAX_FILE_BYTES=5242880

# Admin UI is localhost-only. ADMIN_TOKEN adds bearer-token protection.
ADMIN_PORT=3001
ADMIN_TOKEN=

# Upstream MCP hub config.
MCP_UPSTREAM_CONFIG=profiles/mcp-upstream.json

# Session recovery for ChatGPT reconnects/restarts. Idle sessions expire after 2h by default;
# closed transports are retained for 15m so stale session IDs can recover without accumulating all day.
MCP_SESSION_RECOVERY=true
# MCP_SESSION_TTL_MS=7200000
# MCP_CLOSED_SESSION_TTL_MS=900000
# Hard cap on retained MCP session/server objects; older idle/closed sessions are evicted first.
# Evicted session IDs still use normal stale-session recovery on demand.
# MCP_SESSION_MAX_RETAINED=32
MCP_SESSION_DELETE_GRACE_MS=45000

# Stream MCP tool-call responses as SSE so long calls emit heartbeat frames
# through the connector/tunnel instead of staying completely silent.
MCP_JSON_RESPONSE=false
MCP_SSE_KEEPALIVE_MS=10000

# OpenAI Secure MCP Tunnel credentials, when used.
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=
# Health/readiness endpoint used by the built-in Phase 6 tunnel supervisor.
OPENAI_TUNNEL_HEALTH_PORT=8080
# Normal Windows startup (start.ps1) sets LOCAL_CODER_MANAGE_TUNNEL=1 itself.
# Set this manually only when launching node/npm directly and you want Local Coder
# to own tunnel-client in the same process lifecycle.
# LOCAL_CODER_MANAGE_TUNNEL=1

# ChatGPT may create a fresh MCP transport for each tool call. Hidden shell cwd
# persistence is therefore OFF by default; prefer explicit working_directory.
# Set to 1 only for MCP clients that intentionally reuse a stable transport.
# MCP_SHELL_PERSIST_CWD=0
